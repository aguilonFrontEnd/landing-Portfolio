<!-- 
  ═══════════════════════════════════════════════════════════════════════════
  ANIMACIONES DE DESTELLOS - EQUILIBRIO PERFECTO
  ═══════════════════════════════════════════════════════════════════════════
-->
<style is:global>
  /* Destello 1 - Brillo notable pero elegante */
  @keyframes flash-1 {
    0%, 100% { opacity: 0; transform: scale(0.8); }
    3% { opacity: 0.9; transform: scale(1.8); }
    8% { opacity: 0.3; transform: scale(1.2); }
    12% { opacity: 0; transform: scale(0.8); }
  }
  .animate-flash-1 {
    animation: flash-1 10s ease-in-out infinite;
    animation-delay: 0s;
  }

  /* Destello 2 - Aparición más pausada */
  @keyframes flash-2 {
    0%, 100% { opacity: 0; transform: scale(0.8); }
    5% { opacity: 0.8; transform: scale(1.6); }
    12% { opacity: 0.2; transform: scale(1.1); }
    18% { opacity: 0; transform: scale(0.8); }
  }
  .animate-flash-2 {
    animation: flash-2 14s ease-in-out infinite;
    animation-delay: 4s;
  }

  /* Destello 3 - Sutil pero visible */
  @keyframes flash-3 {
    0%, 100% { opacity: 0; transform: scale(1); }
    4% { opacity: 0.7; transform: scale(1.5); }
    10% { opacity: 0.2; transform: scale(1.1); }
    15% { opacity: 0; transform: scale(1); }
  }
  .animate-flash-3 {
    animation: flash-3 12s ease-in-out infinite;
    animation-delay: 8s;
  }

  /* Destello 4 - Destello suave */
  @keyframes flash-4 {
    0%, 100% { opacity: 0; transform: scale(0.9); }
    6% { opacity: 0.6; transform: scale(1.7); }
    14% { opacity: 0.15; transform: scale(1.2); }
    20% { opacity: 0; transform: scale(0.9); }
  }
  .animate-flash-4 {
    animation: flash-4 16s ease-in-out infinite;
    animation-delay: 2s;
  }

  /* Destello 5 - El más suave de todos */
  @keyframes flash-5 {
    0%, 100% { opacity: 0; transform: scale(1); }
    8% { opacity: 0.5; transform: scale(1.4); }
    16% { opacity: 0.1; transform: scale(1.1); }
    22% { opacity: 0; transform: scale(1); }
  }
  .animate-flash-5 {
    animation: flash-5 18s ease-in-out infinite;
    animation-delay: 6s;
  }
</style>