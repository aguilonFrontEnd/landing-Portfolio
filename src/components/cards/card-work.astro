<!-- TIMELINE DE EXPERIENCIA - Donde se forjó el developer                         -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<section class="relative">
    
  {/* LÍNEA VERTICAL DECORATIVA: Conecta todos los items del timeline */}
  <span class="absolute left-7 top-2 bottom-2 w-0.5 bg-linear-to-b from-yellow-primary via-black-primary/20 to-transparent" aria-hidden="true"></span>

  {/* ITEMS DE EXPERIENCIA: Cada proyecto/posición laboral */}
  {experienceData.map((exp) => (
    <article class="relative flex items-start gap-5 mb-8 group">
      
      {/* AÑO: Círculo decorativo con el año */}
      <time datetime={exp.year} class={`relative z-10 flex items-center justify-center w-15 h-15 rounded-full text-xs font-bold shadow-md transition-all duration-300
        ${exp.isActive 
          ? 'bg-yellow-primary text-black-primary group-hover:bg-black-primary group-hover:text-white-primary' 
          : 'bg-black-primary text-white-primary group-hover:bg-yellow-primary'
        } group-hover:scale-110`}
      >
        {exp.year}
      </time>

      {/* CONTENIDO: Título, rol, tecnologías y badge de activo */}
      <section class="flex-1 pt-1.5">
        
        {/* Título del proyecto/posición */}
        <header>
          <h4 class="text-black-primary font-bold text-sm sm:text-base group-hover:text-yellow-primary transition-colors">
            {exp.title}
          </h4>
        </header>
        
        {/* Rol desempeñado */}
        <p class="text-gray-quaternary text-xs sm:text-sm mt-0.5">
          {exp.role}
        </p>
        
        {/* Stack tecnológico utilizado */}
        <p class="text-gray-tertiary text-[10px] sm:text-xs mt-1 italic">
          {exp.technologies}
        </p>
        
        {/* Badge para el item actualmente activo */}
        {exp.isActive && (
          <footer class="mt-2">
            <span class="inline-block text-[10px] font-medium bg-yellow-primary/20 text-yellow-primary px-2 py-0.5 rounded-full">
              {exp.activeText}
            </span>
          </footer>
        )}
        
      </section>

    </article>
  ))}

</section>