---
/**
 * ═══════════════════════════════════════════════════════════════════════════
 * CARD TECNOLOGÍAS - CARRUSEL DE ICONOS
 * ═══════════════════════════════════════════════════════════════════════════
 * Propósito: Mostrar todas las tecnologías que domina el developer en un
 *            carrusel horizontal que se anima infinitamente vía JavaScript.
 * ═══════════════════════════════════════════════════════════════════════════
 */

// Ya no se necesita import { Image } from "astro:assets"

/**
 * Array de tecnologías para facilitar el mantenimiento.
 * Cada objeto contiene:
 * - name: Nombre de la tecnología (para alt y title)
 * - icon: Ruta pública del icono (desde /assets/Icon/)
 * - url: Link a la documentación oficial
 */
const technologies = [
  { name: "Anaconda", icon: "/assets/Icon/iconANACONDA.png", url: "https://www.anaconda.com/" },
  { name: "Astro", icon: "/assets/Icon/iconASTRO.png", url: "https://astro.build/" },
  { name: "Bootstrap", icon: "/assets/Icon/iconBOOTSTRAP.png", url: "https://getbootstrap.com/" },
  { name: "Canva", icon: "/assets/Icon/iconCANVA.png", url: "https://www.canva.com/" },
  { name: "CSS", icon: "/assets/Icon/iconCSS.png", url: "https://developer.mozilla.org/en-US/docs/Web/CSS" },
  { name: "Figma", icon: "/assets/Icon/iconFIGMA.png", url: "https://www.figma.com/" },
  { name: "Flutter", icon: "/assets/Icon/iconFLUTTER.png", url: "https://flutter.dev/" },
  { name: "HTML", icon: "/assets/Icon/iconHTML.png", url: "https://developer.mozilla.org/en-US/docs/Web/HTML" },
  { name: "JavaScript", icon: "/assets/Icon/iconJS.png", url: "https://developer.mozilla.org/en-US/docs/Web/JavaScript" },
  { name: "Laravel", icon: "/assets/Icon/iconLARAVEL.png", url: "https://laravel.com/docs" },
  { name: "MariaDB", icon: "/assets/Icon/iconMARIADB.png", url: "https://mariadb.org/documentation/" },
  { name: "MySQL", icon: "/assets/Icon/iconMYSQL.png", url: "https://dev.mysql.com/doc/" },
  { name: "PHP", icon: "/assets/Icon/iconPHP.png", url: "https://www.php.net/docs.php" },
  { name: "Power BI", icon: "/assets/Icon/iconPOWERBI.png", url: "https://learn.microsoft.com/power-bi/" },
  { name: "Python", icon: "/assets/Icon/iconPYTHON.png", url: "https://docs.python.org/3/" },
  { name: "SASS", icon: "/assets/Icon/iconSASS.png", url: "https://sass-lang.com/documentation/" },
  { name: "Spyder", icon: "/assets/Icon/iconSPYDER.png", url: "https://docs.spyder-ide.org/" },
  { name: "Tailwind", icon: "/assets/Icon/iconTAILWIND.png", url: "https://tailwindcss.com/docs" },
  { name: "Vue", icon: "/assets/Icon/iconVUE.png", url: "https://vuejs.org/guide/introduction.html" },
  { name: "WordPress", icon: "/assets/Icon/iconWORDPRESS.png", url: "https://wordpress.org/documentation/" },
];
---

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- CARRUSEL DE TECNOLOGÍAS - El arsenal del developer                            -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<section class="py-8 px-5 mb-4 overflow-hidden">
  
  <!-- FIGURE: Contenedor del carrusel que será manipulado por JavaScript -->
  <figure 
    id="carousel-track"
    class="flex gap-5 p-5 xl:gap-14"
    style="will-change: transform;"
  >
    {technologies.map((tech) => (
      <a 
        href={tech.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="shrink-0 transition-transform hover:scale-110"
        title={`Visitar documentación de ${tech.name}`}
      >
        <img 
          src={tech.icon} 
          alt={`Logo de ${tech.name}`} 
          class="w-14 h-14 xl:w-15 xl:h-15 object-contain" 
        />
      </a>
    ))}
    <figcaption class="sr-only">Carrusel de tecnologías dominadas por el developer</figcaption>
  </figure>

</section>