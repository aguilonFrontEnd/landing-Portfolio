<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- GRID DE PROYECTOS - Donde el trabajo habla por sí solo                        -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<section 
  class="max-w-7xl 2xl:max-w-[95%] 3xl:max-w-[90%] mx-auto grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-7"
  role="list"
  aria-label="Lista de proyectos"
  id="projects-grid"
>
  {projectsData.map((project) => (
    <article 
      class="project-card group bg-white-primary border border-gray-primary/30 rounded-2xl overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col"
      role="listitem"
      data-category={project.category}
    >
      {/* ────────────────────────────────────────────────────────────────────── */}
      {/* FIGURE: Imagen del proyecto con overlay en hover                       */}
      {/* ────────────────────────────────────────────────────────────────────── */}
      <figure class="relative overflow-hidden h-48 sm:h-52 lg:h-56 2xl:h-64">
        <img
          src={project.image}
          alt={`Vista previa del proyecto ${project.title}`}
          class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
          loading="lazy"
        />
        <figcaption class="sr-only">{project.title} - Project preview</figcaption>
        {/* Overlay gradiente que aparece en hover */}
        <span class="absolute inset-0 bg-linear-to-t from-black-primary/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></span>
      </figure>

      {/* ────────────────────────────────────────────────────────────────────── */}
      {/* SECTION: Contenido textual del proyecto                                 */}
      {/* ────────────────────────────────────────────────────────────────────── */}
      <section class="p-5 sm:p-6 2xl:p-7 flex flex-col gap-3 sm:gap-4 flex-1">
        
        {/* HEADER: Título y número de proyecto */}
        <header class="flex items-start justify-between gap-3">
          <h3 class="text-lg sm:text-xl 2xl:text-2xl font-bold text-black-primary group-hover:text-yellow-primary transition">
            {project.title}
          </h3>
          <span class="text-4xl sm:text-5xl 2xl:text-6xl font-bold text-gray-primary/20 -mt-2 leading-none" aria-label={`Project number ${project.number}`}>
            {project.number}
          </span>
        </header>

        {/* Descripción del proyecto */}
        <p class="text-gray-quaternary text-sm 2xl:text-base leading-relaxed">
          {project.description}
        </p>

        {/* MENU: Chips de tecnologías usadas */}
        <menu class="flex flex-wrap gap-2 mt-1 not-italic" aria-label="Technologies used">
          {project.technologies.map((tech) => (
            <li class="list-none">
              <span class="px-3 py-1.5 2xl:px-4 2xl:py-2 bg-transparent border border-yellow-primary text-yellow-primary text-xs 2xl:text-sm rounded-full font-medium hover:bg-yellow-primary hover:text-black-primary transition-all duration-300 cursor-default">
                {tech}
              </span>
            </li>
          ))}
        </menu>

        {/* FOOTER: Botón para ver el proyecto */}
        <footer class="mt-auto pt-2">
          <a
            href={project.link}
            class="inline-block w-full text-center bg-black-secondary text-white-primary text-sm 2xl:text-base font-medium px-5 py-3 2xl:py-4 rounded-lg hover:bg-black-primary hover:text-white-primary hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300"
            aria-label={`View project ${project.title}`}
          >
            View Project
          </a>
        </footer>
        
      </section>
    </article>
  ))}
</section>